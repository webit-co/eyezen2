@charset "UTF-8";
a {
  text-decoration: none;
  color: #ff00ff;
}

a:hover {
  text-shadow: none;
}

li {
  list-style: none;
}

#container ul li,
.work_assistance.service ul li {
  padding-left: 1em;
  text-indent: -1em;
  list-style: inherit;
}

#lightbox_menu_w {
  display: flex;
  align-items: center;
  margin-right: 10px;
}

#lightbox_menu .box {
  position: fixed;
  text-align: center;
  overflow: hidden;
  z-index: -1;
  opacity: 0;
  width: 100%;
  height: 100%;
  left: 0px;
  top: 0px;
  background: rgba(0, 0, 0, 0.8);
  -webkit-transition: all 0.3s ease-in-out;
  -moz-transition: all 0.3s ease-in-out;
  -o-transition: all 0.3s ease-in-out;
  transition: all 0.3s ease-in-out;
}

#lightbox_menu ul {
  position: relative;
  top: 20px;
  -webkit-transition: all 0.3s ease-in-out;
  -moz-transition: all 0.3s ease-in-out;
  -o-transition: all 0.3s ease-in-out;
  transition: all 0.3s ease-in-out;
}

#lightbox_menu ul li {
  display: inline-block;
  margin: 0 0 0px 0;
  padding-top: 15px;
  width: 80%;
  text-align: center;
}

#lightbox_menu ul li a {
  border-radius: 3px;
  padding: 15px;
  border: 1px solid #fff;
  text-decoration: none;
  font-size: 18px;
  color: #fff;
  display: block;
  -webkit-transition: all 0.2s ease-in-out;
  -moz-transition: all 0.2s ease-in-out;
  -o-transition: all 0.2s ease-in-out;
  transition: all 0.2s ease-in-out;
}

#lightbox_menu ul li a:hover {
  border-color: #fff;
}

.popup {
  position: absolute;
  opacity: 0;
  color: #fff;
  text-align: center;
  text-shadow: 0px 1px 1px rgba(0, 0, 0, 0.5);
  -webkit-transition-property: opacity, -webkit-transform;
  -webkit-transition-duration: 0.4s;
  -webkit-transform: scale(2, 2);
  -webkit-tap-highlight-color: transparent;
}

.toggle-nav-label {
  display: block;
  cursor: pointer;
  width: 30px;
}
.toggle-nav-label img {
  width: 100%;
}

.close {
  width: 50px;
  text-shadow: none;
  line-height: 30px;
  cursor: pointer;
  z-index: 500;
  border-radius: 5px;
  font-size: 60px;
  color: #FFF;
  position: relative;
  top: 10px;
  left: 80%;
  display: block;
}

/************************
header_area
************************/
header {
  display: flex;
  justify-content: space-between;
  align-content: center;
}
header .logo_area {
  width: 160px;
}
header .logo_area img {
  width: 100%;
}

/************************
メディアクエリ設定 769以上
************************/
@media screen and (min-width: 769px) {
  /*  #lightbox_menu_w {
      display: none;
    }
  */
  #toggle-nav-label {
    font-size: 100%;
  }
}
